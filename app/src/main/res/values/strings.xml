<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">GameBEX</string>
    <!-- Download foreground notification (tappable → Downloads). -->
    <string name="dl_channel">Downloads</string>
    <string name="dl_notif_title">GameBEX downloads</string>
    <string name="dl_notif_idle">Keeping active transfers running…</string>
    <string name="dl_notif_preparing">Preparing downloads…</string>
    <!-- Single transfers use dl_notif_one; this label always has multiple downloads. -->
    <string name="dl_notif_multi" tools:ignore="PluralsCandidate">%1$d downloads · %2$d%%</string>
    <string name="dl_notif_one">%1$s · %2$d%%</string>
    <!-- "Ready to play" notification (tap → game detail, Play action). -->
    <string name="ready_channel">Ready to play</string>
    <string name="ready_notif_title">%1$s is ready</string>
    <string name="ready_notif_text">Downloaded and set up. Tap for details.</string>
    <string name="ready_action_play">Play</string>
    <!-- Storage grant surfacing (Home banner, System header). -->
    <!-- The retained System route still references this resource ID. -->
    <string name="storage_files_grant" tools:ignore="UnusedResources">FILES: GRANT</string>
    <!-- Catalog pagination footer. -->
    <string name="catalog_page_scroll_retry">%1$s — scroll to retry.</string>
    <!-- Challenge assist. -->
    <string name="assist_blocked_redirect">Blocked a redirect outside the file host.</string>
</resources>
