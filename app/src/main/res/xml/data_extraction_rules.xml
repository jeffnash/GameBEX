<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ uses these rules instead of backup_rules. Keep the same
  credential excludes, and leave together.xml behind so a restored phone
  does not reuse this device id.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ss_creds_enc.xml" />
        <exclude domain="sharedpref" path="screenscraper.xml" />
        <exclude domain="sharedpref" path="together.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ss_creds_enc.xml" />
        <exclude domain="sharedpref" path="screenscraper.xml" />
        <exclude domain="sharedpref" path="together.xml" />
    </device-transfer>
</data-extraction-rules>
