        },
        "condition": {
          "$ref": "#/$defs/expr"
        },
        "then": {
          "$ref": "#/$defs/expr"
        },
        "else": {
          "$ref": "#/$defs/expr"
        }
      },
      "additionalProperties": false
    },
    "opEq": {
      "required": [
        "op",
        "left",
        "right"
      ],
      "properties": {
        "op": {
          "const": "eq"
        },
        "left": {
          "$ref": "#/$defs/expr"
        },
        "right": {
          "$ref": "#/$defs/expr"
        },
        "ignoreCase": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "opLt": {
      "required": [
        "op",
        "left",
        "right"
      ],
      "properties": {
        "op": {
          "const": "lt"
        },
        "left": {
          "$ref": "#/$defs/expr"
