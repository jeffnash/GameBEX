{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamebex.example/source.schema.json",
  "title": "GameBEX ROM source definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "author",
    "version",
    "requires",
    "origins",
    "platforms",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "origins": {
      "$ref": "#/$defs/origins"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "assist": {
      "$ref": "#/$defs/assist"
    },
    "operations": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "origins": {
      "type": "object",
      "required": [
        "catalog",
        "download",
        "artwork"
      ],
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/originSet"
        },
        "download": {
          "$ref": "#/$defs/originSet"
        },
        "artwork": {
          "$ref": "#/$defs/originSet"
        },
        "assist": {
          "$ref": "#/$defs/originSet"
        }
      }
    },
    "originSet": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "preferIpv4": {
          "type": "boolean"
        }
      }
    },
    "assist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "triggerStatuses": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "javascript": {
          "type": "boolean"
        },
        "domStorage": {
          "type": "boolean"
        },
        "userAgent": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "inputs",
        "steps",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "result": {
          "$ref": "#/$defs/expr"
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "cache": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "value": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/expr"
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "form": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "onEmpty": {
          "type": "boolean"
        },
        "onFailures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "pathSegments": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "integer"
        ],
        "minimum": 0
      }
    },
    "expr": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/exprShape"
        }
      ]
    },
    "exprShape": {
      "anyOf": [
        {
          "$ref": "#/$defs/opLiteral"
        },
        {
          "$ref": "#/$defs/opRef"
        },
        {
          "$ref": "#/$defs/opObject"
        },
        {
          "$ref": "#/$defs/opArray"
        },
        {
          "$ref": "#/$defs/opJson"
        },
        {
          "$ref": "#/$defs/opGet"
        },
        {
          "$ref": "#/$defs/opHtml"
        },
        {
          "$ref": "#/$defs/opSelect"
        },
        {
          "$ref": "#/$defs/opText"
        },
        {
          "$ref": "#/$defs/opAttr"
        },
        {
          "$ref": "#/$defs/opMap"
        },
        {
          "$ref": "#/$defs/opFilter"
        },
        {
          "$ref": "#/$defs/opFirst"
        },
        {
          "$ref": "#/$defs/opCoalesce"
        },
        {
          "$ref": "#/$defs/opIf"
        },
        {
          "$ref": "#/$defs/opEq"
        },
        {
          "$ref": "#/$defs/opLt"
        },
        {
          "$ref": "#/$defs/opNot"
        },
        {
          "$ref": "#/$defs/opContains"
        },
        {
          "$ref": "#/$defs/opConcat"
        },
        {
          "$ref": "#/$defs/opTrim"
        },
        {
          "$ref": "#/$defs/opTrimEnd"
        },
        {
          "$ref": "#/$defs/opHtmlDecode"
        },
        {
          "$ref": "#/$defs/opReplace"
        },
        {
          "$ref": "#/$defs/opBefore"
        },
        {
          "$ref": "#/$defs/opAfter"
        },
        {
          "$ref": "#/$defs/opBeforeLast"
        },
        {
          "$ref": "#/$defs/opAfterLast"
        },
        {
          "$ref": "#/$defs/opInt"
        },
        {
          "$ref": "#/$defs/opDouble"
        },
        {
          "$ref": "#/$defs/opDigits"
        },
        {
          "$ref": "#/$defs/opAdd"
        },
        {
          "$ref": "#/$defs/opSize"
        },
        {
          "$ref": "#/$defs/opDistinct"
        },
        {
          "$ref": "#/$defs/opSort"
        },
        {
          "$ref": "#/$defs/opPlatform"
        },
        {
          "$ref": "#/$defs/opLookup"
        },
        {
          "$ref": "#/$defs/opInvoke"
        },
        {
          "$ref": "#/$defs/opPathSegment"
        }
      ]
    },
    "opLiteral": {
      "required": [
        "op",
        "value"
      ],
      "properties": {
        "op": {
          "const": "literal"
        },
        "value": true
      },
      "additionalProperties": false
    },
    "opRef": {
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "const": "ref"
        },
        "path": {
          "$ref": "#/$defs/pathSegments"
        }
      },
      "additionalProperties": false
    },
    "opObject": {
      "required": [
        "op",
        "fields"
      ],
      "properties": {
        "op": {
          "const": "object"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expr"
          }
        }
      },
      "additionalProperties": false
    },
    "opArray": {
      "required": [
        "op",
        "items"
      ],
      "properties": {
        "op": {
          "const": "array"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expr"
          }
        }
